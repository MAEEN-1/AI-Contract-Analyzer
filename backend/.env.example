# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase project MAEEN: Dashboard -> Project Settings -> API
SUPABASE_URL=https://qtgxldycxaghkvgsxbet.supabase.co
# Server-side key. Use the secret (service_role) key once the backend writes to
# contracts / analysis_results / chat_history: only service_role can write there.
SUPABASE_KEY=

# Exact origin of the frontend, e.g. http://localhost:5173. Several origins are
# separated by commas, e.g. http://localhost:5510,https://your-site.netlify.app.
# When empty, no CORS headers are sent and a browser frontend on another origin
# cannot call the API.
FRONTEND_URL=

# OpenAI, for the MAEEN Assistant and the AI Backend (same names as ai_backend/.env.example).
# When OPENAI_API_KEY or CHAT_MODEL is empty, the AI endpoints answer 503.
OPENAI_API_KEY=
# The cheapest current model is gpt-6-luna.
CHAT_MODEL=
# Optional, for reasoning models: none, low, medium or high. "low" keeps the assistant fast.
CHAT_REASONING_EFFORT=
EMBEDDING_MODEL=text-embedding-3-small

# Contract analysis and questions (ai_backend/) also need the direct database
# connection string: Dashboard -> Connect -> Session pooler. Server-side secret.
# The service_role key is taken from SUPABASE_KEY above.
SUPABASE_DB_URL=
