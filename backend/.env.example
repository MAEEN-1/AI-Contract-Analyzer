# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase project MAEEN: Dashboard -> Project Settings -> API
SUPABASE_URL=https://qtgxldycxaghkvgsxbet.supabase.co
# Server-side key. Use the secret (service_role) key once the backend writes to
# contracts / analysis_results / chat_history: only service_role can write there.
SUPABASE_KEY=

# Exact origin of the frontend, e.g. http://localhost:5173. When empty, no CORS
# headers are sent and a browser frontend on another origin cannot call the API.
FRONTEND_URL=
